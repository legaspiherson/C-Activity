        if (packageNum <= 0) {
            cout << "Invalid Package Number! Please choose from 1-5.\n";
        }    
    } while (packageNum <= 0);
    
    price = 0.0;
    
    if (packageNum == 1) {
        price = 1000;
        pork++;
